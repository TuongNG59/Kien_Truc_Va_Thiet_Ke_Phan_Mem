@startuml
'https://plantuml.com/class-diagram

abstract class MenhGiaATM
{
    int menhGia
    + {abstract} MenhGiaATM keTiep(MenhGiaATM m)
    + {abstract} int rutTien(int soTien)
}
class MenhGiaThapNhat
class MenhGia


MenhGiaATM <|-- MenhGiaThapNhat
MenhGiaATM <|-- MenhGia
MenhGia --> MenhGiaATM : keTiep

@enduml