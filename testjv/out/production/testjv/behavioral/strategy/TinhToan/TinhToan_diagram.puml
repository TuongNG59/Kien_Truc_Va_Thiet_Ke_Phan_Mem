@startuml
'https://plantuml.com/class-diagram

interface Tinh{
    + tinh (float a, float b) :float
}

class context{
    - tinhToan: Tinh
    + setTinhToan (Tinh tinhToan) : void
    + tinh (float a, float b) :float
}

class Cong{
    + <<Implement>> tinh (float, float b) : float
}

class Tru{
    + <<Implement>> tinh (float, float b) : float
}

class Nhan{
    + <<Implement>> tinh (float, float b) : float
}

class Chia{
    + <<Implement>> tinh (float, float b) : float
}



context-->Tinh
Tinh<|..Cong
Tinh<|..Tru
Tinh<|..Nhan
Tinh<|..Chia
@enduml