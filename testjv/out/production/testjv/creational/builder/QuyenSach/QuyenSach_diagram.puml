@startuml
'https://plantuml.com/class-diagram

class Book{
    String tuaDe, tacGia
    int soTrang
    List<String> chuongs
    # Book(Builder b)
    + String toString()
}

class Builder{
    String tuaDe, tacGia
    int soTrang
    List<String> chuongs

    + Builder setTuaDe(String tuaDe)
    + Builder setSoTrang(int soTrang)
    + Builder setTacGia(String tacGia)
    + Builder addChuong(String chuong)
    + Book build();
}

Builder..>Book
@enduml